# JDBC connection string used by Spring Boot and Docker Compose backend service
DB_URL=jdbc:mysql://localhost:3306/shopping_system?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Database username for the application connection
DB_USERNAME=root

# Database password for MySQL root/application access in local and Docker runs
DB_PASSWORD=Sreu@2006

# Host port exposed by the Docker MySQL container; change this if local MySQL already uses 3306
MYSQL_HOST_PORT=3308

# JWT signing key encoded in Base64
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=QWJjZEVmR2hJaktsTW5PcFFyU3RVdld4WXowMTIzNDU2Nzg5KysvPQ==

# JWT lifetime in milliseconds
JWT_EXPIRATION_MS=86400000

# Allowed frontend origin for credentialed CORS requests; defaults to localhost in development
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Seeded admin username created on startup if it does not already exist
ADMIN_USERNAME=admin

# Seeded admin password created on startup if it does not already exist
ADMIN_PASSWORD=Admin@123
